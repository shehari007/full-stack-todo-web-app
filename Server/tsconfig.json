{
  "compilerOptions": {
    /* Language & module system: native Node ESM. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Emit. `outDir` and `rootDir` live in tsconfig.build.json instead, so that
       this config can typecheck files outside src/ (the Vercel entrypoint in
       api/) without tripping the "not under rootDir" error. */
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,

    /* Strictness. Every one of these has caught a real bug in this codebase. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    /* Interop */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  /* `api/` holds the Vercel entrypoint. It is not part of the tsc build (Vercel
     compiles it itself), but it must still be typechecked, or a broken import
     there is only discovered by a failed deploy. */
  "include": ["src/**/*.ts", "api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
