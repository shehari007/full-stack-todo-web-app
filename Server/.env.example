# ==========================================================================
# TaskFlow API environment
#
#   cp .env.example .env
#   npm run gen:secret        # generates the three secrets below
#
# Every value here is validated at boot by src/config/env.ts. If something is
# missing or unsafe the server refuses to start and tells you which key.
# ==========================================================================

NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskflow
#
# Supabase: use the SESSION POOLER connection string (port 5432), not the
# transaction pooler (6543). Prepared statements, which Drizzle uses, are not
# supported on the transaction pooler.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase and most hosted Postgres require TLS. Local Postgres does not.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --------------------------------------------------------------------------
# Secrets. Generate them with: npm run gen:secret
# --------------------------------------------------------------------------
# Minimum 32 characters each, and the two JWT secrets must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Base64 that decodes to exactly 32 bytes. Encrypts TOTP secrets at rest.
# Changing it makes existing MFA enrolments unreadable, so users must re-enrol.
ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# MUST be true in production: the server refuses to start otherwise.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Only set when the API and web app are on different subdomains of one site.
# COOKIE_DOMAIN=.example.com

# --------------------------------------------------------------------------
# Origins
# --------------------------------------------------------------------------
# Exact origins, comma separated. No wildcards: credentialed CORS forbids "*".
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Number of reverse proxies in front of this server, or false when directly
# exposed. This decides whether X-Forwarded-For is trusted for req.ip, which is
# the rate-limiter key. Setting it too high lets clients spoof their address.
#   bare Node, no proxy .......... 0
#   Vercel / Render / Railway .... 1
#   Cloudflare -> your proxy ..... 2
TRUST_PROXY=0

# --------------------------------------------------------------------------
# Upload limits (seed values only)
# --------------------------------------------------------------------------
# These populate the database on first `npm run db:seed`. After that the root
# control panel is authoritative, so a quota change needs no redeploy.
MAX_UPLOAD_BYTES=1048576              # 1 MB per file
USER_STORAGE_QUOTA_BYTES=26214400     # 25 MB per standard user
ROOT_STORAGE_QUOTA_BYTES=536870912    # 512 MB for root and admins

# --------------------------------------------------------------------------
# Root account bootstrap, consumed by `npm run db:seed`
# --------------------------------------------------------------------------
ROOT_USERNAME=root
ROOT_EMAIL=root@taskflow.local
# Leave blank and the seed generates a strong password and prints it once.
# If you set it, minimum 12 characters.
ROOT_PASSWORD=
