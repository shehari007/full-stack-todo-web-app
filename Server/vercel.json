{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "npm ci --include=dev",

  "buildCommand": "npm run build",

  "outputDirectory": "public",

  "framework": null,

  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],

  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
