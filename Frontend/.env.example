# ==========================================================================
# TaskFlow web app: environment
#
#   cp .env.example .env.local
# ==========================================================================

# Where the Express API lives, as seen from the Next.js SERVER process.
#
# The browser never uses this. next.config.ts rewrites /api/* to this origin so
# that everything stays same-origin, which is what lets the session cookies use
# SameSite=Lax instead of the weaker SameSite=None.
API_ORIGIN=http://localhost:8000

# Public URL of this site. Used for canonical links, sitemap.xml and Open Graph
# image URLs. The root control panel's SEO section overrides this when set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
